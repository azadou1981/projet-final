{% extends 'base.html.twig' %}

{% block title %}{{ produit.nom }} - Crystal{% endblock %}

{% block body %}
<div class="produit-detail">
    <div class="produit-image">
        <img src="{{ produit.image ? asset('uploads/' ~ produit.image) : 'https://placehold.co/500x500' }}" alt="{{ produit.nom }}">
    </div>
    <div class="produit-infos">
        <h1>{{ produit.nom }}</h1>
        <p class="prix">{{ produit.prix }} €</p>
        <p>{{ produit.description }}</p>
        <p><strong>Stock :</strong> {{ produit.stock }}</p>
        <a href="{{ path('app_panier_ajouter', {'id': produit.id}) }}" class="btn">Ajouter au panier</a>
    </div>
</div>
{% endblock %}
