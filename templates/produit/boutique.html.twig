{% extends 'base.html.twig' %}

{% block title %}Boutique - Crystal{% endblock %}

{% block body %}
<h1>Notre boutique</h1>
<div class="produits-grille">
    {% for produit in produits %}
        <article class="produit-carte">
            <a href="{{ path('app_produit_voir', {'id': produit.id}) }}">
                <img src="{{ produit.image ? asset('uploads/' ~ produit.image) : 'https://placehold.co/300x300' }}" alt="{{ produit.nom }}">
            </a>
            <h3>{{ produit.nom }}</h3>
            <p class="prix">{{ produit.prix }} €</p>
            <a href="{{ path('app_produit_voir', {'id': produit.id}) }}" class="btn-petit">Détails</a>
        </article>
    {% endfor %}
</div>
{% endblock %}
