{% extends 'base.html.twig' %}

{% block title %}Finaliser - CRYSTAL{% endblock %}

{% block body %}
<h1>Finaliser la <span class="or">commande</span></h1>

<div class="table-wrapper">
    <table class="panier-table">
        <thead>
            <tr>
                <th>Produit</th>
                <th>Quantité</th>
                <th>Total</th>
            </tr>
        </thead>
        <tbody>
            {% for item in panier %}
            <tr>
                <td><strong style="color: var(--blanc); text-transform: uppercase;">{{ item.produit.nom }}</strong></td>
                <td>{{ item.quantite }}</td>
                <td>{{ item.total }} €</td>
            </tr>
            {% endfor %}
        </tbody>
        <tfoot>
            <tr>
                <td><strong>Total</strong></td>
                <td></td>
                <td><strong style="font-size: 1.3rem; color: var(--or);">{{ total }} €</strong></td>
            </tr>
        </tfoot>
    </table>
</div>

<div class="panier-actions">
    <a href="{{ path('app_panier') }}" class="btn-outline">← Retour</a>
    <a href="{{ path('app_commande_confirmer') }}" class="btn">Confirmer →</a>
</div>
{% endblock %}
