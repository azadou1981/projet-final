{% extends 'base.html.twig' %}

{% block title %}Panier - Crystal{% endblock %}

{% block body %}
<h1>Mon panier</h1>

{% if panier is empty %}
    <p>Votre panier est vide.</p>
    <a href="{{ path('app_boutique') }}" class="btn">Voir la boutique</a>
{% else %}
    <table class="panier-table">
        <thead>
            <tr>
                <th>Produit</th>
                <th>Prix</th>
                <th>Quantité</th>
                <th>Total</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {% for item in panier %}
            <tr>
                <td>{{ item.produit.nom }}</td>
                <td>{{ item.produit.prix }} €</td>
                <td>{{ item.quantite }}</td>
                <td>{{ item.total }} €</td>
                <td><a href="{{ path('app_panier_supprimer', {'id': item.produit.id}) }}" class="btn-supprimer">Supprimer</a></td>
            </tr>
            {% endfor %}
        </tbody>
        <tfoot>
            <tr>
                <td colspan="3"><strong>Total</strong></td>
                <td><strong>{{ total }} €</strong></td>
                <td></td>
            </tr>
        </tfoot>
    </table>

    <a href="{{ path('app_panier_commander') }}" class="btn">Commander</a>
{% endif %}
{% endblock %}
