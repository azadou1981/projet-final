{% extends 'base.html.twig' %}

{% block title %}Connexion - CRYSTAL{% endblock %}

{% block body %}
<div class="form-card">
    {% if error %}
        <div class="flash-error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}

    {% if app.user %}
        <p>Connecté en tant que <strong style="color: var(--or);">{{ app.user.userIdentifier }}</strong></p>
        <a href="{{ path('app_logout') }}" class="btn" style="margin-top: 1rem;">Déconnexion</a>
    {% else %}
        <h1 style="margin-top: 0;">Connexion</h1>

        <form method="post">
            <div class="form-group">
                <label for="inputEmail">Email</label>
                <input type="email" value="{{ last_username }}" name="email" id="inputEmail" autocomplete="email" required autofocus placeholder="exemple@email.com">
            </div>

            <div class="form-group">
                <label for="inputPassword">Mot de passe</label>
                <input type="password" name="password" id="inputPassword" autocomplete="current-password" required placeholder="••••••••">
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <div class="form-group checkbox-group">
                <input type="checkbox" name="_remember_me" id="remember">
                <label for="remember">Se souvenir de moi</label>
            </div>

            <button class="btn" type="submit">Se connecter →</button>
        </form>

        <p style="text-align: center; margin-top: 1.5rem; color: var(--gris);">
            Pas encore de compte ? <a href="{{ path('app_register') }}" style="color: var(--or); font-weight: 600;">S'inscrire</a>
        </p>
    {% endif %}
</div>
{% endblock %}
