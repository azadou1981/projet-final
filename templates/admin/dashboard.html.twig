{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title %}🔧 Tableau de bord - Crystal{% endblock %}

{% block head_stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/admin.css') }}">
{% endblock %}

{% block page_content %}
    <div class="admin-container">
        <div class="admin-alert">
            <h4>Bienvenue dans l'administration Crystal !</h4>
            <p>Gérez vos produits, commandes et utilisateurs depuis le menu de gauche.</p>
        </div>

        <div class="admin-grid">
            <a href="{{ ea_url().setController('App\\Controller\\Admin\\ProduitCrudController').setAction('index') }}" class="admin-card">
                <div class="icon">📦</div>
                <h3>Produits</h3>
                <span class="admin-badge">Gérer</span>
            </a>

            <a href="{{ ea_url().setController('App\\Controller\\Admin\\CommandeCrudController').setAction('index') }}" class="admin-card">
                <div class="icon">🛒</div>
                <h3>Commandes</h3>
                <span class="admin-badge">Gérer</span>
            </a>

            <a href="{{ ea_url().setController('App\\Controller\\Admin\\UtilisateurCrudController').setAction('index') }}" class="admin-card">
                <div class="icon">👥</div>
                <h3>Utilisateurs</h3>
                <span class="admin-badge">Gérer</span>
            </a>
        </div>
    </div>
{% endblock %}
