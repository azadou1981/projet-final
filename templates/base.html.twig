<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}CRYSTAL{% endblock %}</title>
    <link rel="icon" type="image/png" href="{{ asset('favicon.png') }}">
    {% block stylesheets %}
    <style>
        /* ===== RESET ===== */
        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

        /* ===== VARIABLES STREETWEAR ===== */
        :root {
            --noir-profond: #0a0a0a;
            --noir: #111111;
            --noir-clair: #1a1a1a;
            --gris-fonce: #222222;
            --gris: #555555;
            --gris-clair: #333333;
            --blanc: #ffffff;
            --blanc-casse: #e8e8e8;
            --or: #d4a843;
            --or-fonce: #b8922e;
            --or-brillant: #f0c850;
            --dorure: linear-gradient(135deg, #d4a843, #f0c850, #d4a843);
            --transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
            --ombre: 0 10px 40px rgba(0,0,0,0.3);
        }

        /* ===== GÉNÉRAL ===== */
        html { scroll-behavior: smooth; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
            line-height: 1.6;
            color: var(--blanc-casse);
            background: var(--noir-profond);
            -webkit-font-smoothing: antialiased;
        }
        .conteneur { max-width: 1200px; margin: 0 auto; padding: 0 24px; }

        /* ===== TYPOGRAPHIE ===== */
        h1, h2, h3 {
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
        h1 { 
            font-size: 3rem; 
            text-align: center; 
            margin: 2.5rem 0; 
            color: var(--blanc); 
        }
        h1 span.or, .text-or { background: var(--dorure); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
        h2 { font-size: 2rem; margin: 2rem 0 1.5rem; }
        h3 { font-size: 1.2rem; }
        p { color: var(--gris); }

        /* ===== HEADER ===== */
        header {
            background: rgba(10, 10, 10, 0.98);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            border-bottom: 1px solid rgba(212, 168, 67, 0.1);
            color: var(--blanc);
            padding: 0.6rem 0;
            position: sticky;
            top: 0;
            z-index: 1000;
        }
        header .conteneur {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        header a { color: rgba(255,255,255,0.7); text-decoration: none; transition: var(--transition); }
        header a:hover { color: var(--or); }
        header .logo { display: flex; align-items: center; }
        header .logo img { height: 5rem; width: auto; display: block; filter: drop-shadow(0 0 10px rgba(212,168,67,0.2)); }
        header nav {
            display: flex;
            align-items: center;
            gap: 0.1rem;
        }
        header nav a {
            padding: 0.4rem 0.9rem;
            font-size: 0.8rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            border-radius: 0;
            transition: var(--transition);
            position: relative;
        }
        header nav a:hover {
            color: var(--or-brillant);
            background: rgba(212, 168, 67, 0.08);
        }
        header nav a.actif { color: var(--or); }
        .badge-panier {
            background: var(--or);
            color: var(--noir);
            padding: 1px 7px;
            font-size: 0.7rem;
            font-weight: 800;
            border-radius: 0;
            margin-left: 4px;
        }

        /* ===== HERO ===== */
        .hero {
            position: relative;
            background: var(--noir);
            color: var(--blanc);
            text-align: center;
            padding: 8rem 2rem 6rem;
            margin-bottom: 3rem;
            overflow: hidden;
            isolation: isolate;
            border-bottom: 1px solid rgba(212,168,67,0.08);
        }
        .hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background: 
                radial-gradient(ellipse at 30% 50%, rgba(212,168,67,0.06) 0%, transparent 60%),
                radial-gradient(ellipse at 70% 20%, rgba(212,168,67,0.04) 0%, transparent 50%),
                radial-gradient(ellipse at 50% 80%, rgba(255,255,255,0.02) 0%, transparent 40%);
            z-index: -1;
        }
        .hero h1 {
            font-size: 5rem;
            margin-bottom: 1.5rem;
            letter-spacing: 0.15em;
            line-height: 1;
        }
        .hero h1 span.or {
            display: block;
            font-size: 6rem;
        }
        .hero p {
            font-size: 1.1rem;
            margin-bottom: 2.5rem;
            color: rgba(255,255,255,0.5);
            font-weight: 300;
            text-transform: uppercase;
            letter-spacing: 0.2em;
            max-width: 500px;
            margin-left: auto;
            margin-right: auto;
        }

        /* ===== BOUTONS ===== */
        .btn {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            background: var(--dorure);
            color: var(--noir);
            padding: 0.9rem 2.5rem;
            text-decoration: none;
            border-radius: 0;
            font-weight: 700;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            transition: var(--transition);
            border: none;
            cursor: pointer;
        }
        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 30px rgba(212, 168, 67, 0.3);
        }
        .btn:active { transform: translateY(0); }

        .btn-outline {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            background: transparent;
            color: var(--blanc);
            padding: 0.6rem 1.5rem;
            text-decoration: none;
            border-radius: 0;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            transition: var(--transition);
            border: 1px solid var(--gris-clair);
        }
        .btn-outline:hover {
            border-color: var(--or);
            color: var(--or);
        }

        .btn-petit {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            background: transparent;
            color: var(--blanc);
            padding: 0.5rem 1.2rem;
            text-decoration: none;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            transition: var(--transition);
            border: 1px solid var(--gris-clair);
        }
        .btn-petit:hover {
            background: var(--blanc);
            color: var(--noir);
            border-color: var(--blanc);
        }

        /* ===== GRILLE PRODUITS ===== */
        .produits-section { padding: 1rem 0 4rem; }
        .produits-section .section-titre {
            text-align: center;
            margin-bottom: 3rem;
            font-size: 2.5rem;
            position: relative;
            padding-bottom: 1rem;
        }
        .produits-section .section-titre::after {
            content: '';
            display: block;
            width: 40px;
            height: 2px;
            background: var(--or);
            margin: 1rem auto 0;
        }
        .produits-grille {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 1.5rem;
            max-width: 1200px;
            margin: 0 auto;
        }

        .produit-carte {
            background: var(--noir);
            border: 1px solid var(--gris-clair);
            transition: var(--transition);
            position: relative;
            display: flex;
            flex-direction: column;
        }
        .produit-carte:hover {
            border-color: var(--or);
            transform: translateY(-4px);
            box-shadow: var(--ombre);
        }
        .produit-carte .image-wrapper {
            width: 100%;
            height: 300px;
            overflow: hidden;
            position: relative;
            background: var(--noir-clair);
            border-bottom: 1px solid var(--gris-clair);
        }
        .produit-carte .image-wrapper img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.6s ease;
            image-rendering: auto;
        }
        .produit-carte:hover .image-wrapper img { transform: scale(1.05); }
        .produit-carte .card-body {
            padding: 1.2rem 1.2rem 1rem;
            flex: 1;
            display: flex;
            flex-direction: column;
        }
        .produit-carte h3 {
            font-weight: 700;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 0.3rem;
            color: var(--blanc);
        }
        .produit-carte .prix {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--or);
            margin-bottom: 0.8rem;
        }
        .produit-carte .card-footer {
            margin-top: auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-top: 0.5rem;
            border-top: 1px solid var(--gris-clair);
        }

        /* ===== DÉTAIL PRODUIT ===== */
        .produit-detail {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 3rem;
            max-width: 1000px;
            margin: 2rem auto;
            padding: 2rem;
            background: var(--noir);
            border: 1px solid var(--gris-clair);
        }
        .produit-detail .produit-image {
            overflow: hidden;
            background: var(--noir-clair);
            border: 1px solid var(--gris-clair);
        }
        .produit-detail .produit-image img {
            width: 100%;
            height: auto;
            display: block;
            transition: transform 0.6s ease;
        }
        .produit-detail .produit-image:hover img { transform: scale(1.03); }
        .produit-detail h1 {
            text-align: left;
            margin: 0 0 0.5rem;
            font-size: 2.2rem;
        }
        .produit-detail .prix {
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--or);
            margin: 1rem 0;
        }
        .produit-detail .description {
            color: var(--gris);
            line-height: 1.7;
            margin: 1rem 0;
        }
        .produit-detail .stock-info {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.3rem 0.8rem;
            background: rgba(255,255,255,0.05);
            color: var(--blanc-casse);
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            border: 1px solid var(--gris-clair);
        }
        .produit-detail .stock-info.faible {
            color: var(--or);
            border-color: rgba(212,168,67,0.3);
        }
        .produit-detail .btn { margin-top: 1.5rem; }

        /* ===== TABLEAU ===== */
        .table-wrapper {
            background: var(--noir);
            border: 1px solid var(--gris-clair);
            margin: 2rem 0;
        }
        .panier-table {
            width: 100%;
            border-collapse: collapse;
        }
        .panier-table thead {
            background: var(--noir-clair);
            border-bottom: 2px solid var(--or);
        }
        .panier-table th {
            padding: 1rem;
            text-align: left;
            color: var(--or);
            font-weight: 700;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.1em;
        }
        .panier-table td {
            padding: 1rem;
            border-bottom: 1px solid var(--gris-clair);
            color: var(--blanc-casse);
        }
        .panier-table tbody tr { transition: background 0.2s; }
        .panier-table tbody tr:hover { background: rgba(212,168,67,0.03); }
        .panier-table tbody tr:last-child td { border-bottom: none; }
        .panier-table tfoot td {
            padding: 1rem;
            font-size: 1rem;
            border-top: 2px solid var(--gris-clair);
            color: var(--blanc);
        }
        .btn-supprimer {
            color: #ff4444;
            text-decoration: none;
            font-weight: 700;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            transition: var(--transition);
        }
        .btn-supprimer:hover { color: #ff6666; }
        .panier-actions {
            display: flex;
            gap: 1rem;
            margin: 2rem 0;
        }

        /* ===== STATS ===== */
        .stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1.5rem;
            margin: 2rem 0;
        }
        .stat-carte {
            background: var(--noir);
            border: 1px solid var(--gris-clair);
            padding: 2.5rem;
            text-align: center;
            transition: var(--transition);
        }
        .stat-carte:hover {
            border-color: var(--or);
            transform: translateY(-3px);
        }
        .stat-carte h3 {
            font-size: 3rem;
            color: var(--or);
            margin-bottom: 0.3rem;
        }
        .stat-carte p { color: var(--gris); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.08em; }

        /* ===== SUCCÈS ===== */
        .succes-page {
            text-align: center;
            padding: 6rem 2rem;
            max-width: 600px;
            margin: 0 auto;
        }
        .succes-page .icone { font-size: 4rem; margin-bottom: 1.5rem; }
        .succes-page h1 { margin-bottom: 1rem; }
        .succes-page p { font-size: 1.1rem; margin: 0.5rem 0; color: var(--gris); }
        .succes-page .btn { margin-top: 2rem; }

        /* ===== FORMULAIRES ===== */
        .form-card {
            background: var(--noir);
            border: 1px solid var(--gris-clair);
            padding: 3rem;
            max-width: 480px;
            margin: 2rem auto;
        }
        .form-card h1 { margin-top: 0; }
        form { width: 100%; }
        form .form-group { margin-bottom: 1.5rem; }
        form label {
            display: block;
            margin-bottom: 0.5rem;
            font-weight: 700;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--blanc-casse);
        }
        form input[type="text"],
        form input[type="email"],
        form input[type="password"],
        form input[type="number"],
        form textarea,
        form select {
            width: 100%;
            padding: 0.9rem 1rem;
            border: 1px solid var(--gris-clair);
            font-size: 0.95rem;
            font-family: inherit;
            transition: var(--transition);
            background: var(--noir-clair);
            color: var(--blanc);
            border-radius: 0;
        }
        form input:focus,
        form textarea:focus,
        form select:focus {
            border-color: var(--or);
            outline: none;
            background: var(--noir);
        }
        form input[type="checkbox"] {
            width: auto;
            margin-right: 0.5rem;
            accent-color: var(--or);
        }
        form .checkbox-group {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        form .checkbox-group label { margin: 0; font-weight: 400; text-transform: none; letter-spacing: normal; }
        form .btn { width: 100%; justify-content: center; margin-top: 0.5rem; }

        /* ===== FLASH MESSAGES ===== */
        .flash-succes {
            background: rgba(212,168,67,0.08);
            color: var(--or);
            padding: 1rem 1.5rem;
            margin: 1.5rem 0;
            border-left: 3px solid var(--or);
            font-weight: 500;
            font-size: 0.9rem;
            animation: slideIn 0.4s ease;
        }
        .flash-error {
            background: rgba(255,68,68,0.08);
            color: #ff6666;
            padding: 1rem 1.5rem;
            margin: 1.5rem 0;
            border-left: 3px solid #ff4444;
            animation: slideIn 0.4s ease;
            font-weight: 500;
        }

        /* ===== FOOTER ===== */
        footer {
            background: var(--noir);
            color: rgba(255,255,255,0.4);
            text-align: center;
            padding: 3rem 2rem;
            margin-top: 5rem;
            border-top: 1px solid rgba(212,168,67,0.08);
        }
        footer p { color: rgba(255,255,255,0.3); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.1em; }
        footer .footer-links {
            display: flex;
            justify-content: center;
            gap: 2rem;
            margin-bottom: 1.5rem;
        }
        footer .footer-links a {
            color: rgba(255,255,255,0.4);
            text-decoration: none;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            transition: var(--transition);
        }
        footer .footer-links a:hover { color: var(--or); }

        /* ===== PAGE CONTACT / ABOUT ===== */
        .page-content {
            max-width: 700px;
            margin: 0 auto 3rem;
        }
        .contact-card {
            background: var(--noir);
            border: 1px solid var(--gris-clair);
            padding: 2.5rem;
            margin-top: 2rem;
        }
        .contact-card p {
            margin: 1rem 0;
            display: flex;
            align-items: flex-start;
            gap: 0.8rem;
            color: var(--blanc-casse);
        }
        .contact-card p strong {
            min-width: 120px;
            color: var(--or);
            font-weight: 700;
            text-transform: uppercase;
            font-size: 0.8rem;
            letter-spacing: 0.05em;
        }

        /* ===== EMPTY STATE ===== */
        .empty-state {
            text-align: center;
            padding: 5rem 2rem;
        }
        .empty-state .emoji { font-size: 4rem; margin-bottom: 1rem; filter: grayscale(1); }
        .empty-state p { margin-bottom: 2rem; color: var(--gris); text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.9rem; }

        /* ===== ANIMATIONS ===== */
        @keyframes fadeInDown {
            from { opacity: 0; transform: translateY(-30px); }
            to { opacity: 1; transform: translateY(0); }
        }
        @keyframes slideIn {
            from { opacity: 0; transform: translateX(-20px); }
            to { opacity: 1; transform: translateX(0); }
        }

        /* ===== RESPONSIVE ===== */
        @media (max-width: 1024px) {
            .produits-grille { grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); }
        }
        @media (max-width: 768px) {
            header .conteneur { flex-direction: column; gap: 0.6rem; }
            header nav { flex-wrap: wrap; justify-content: center; }
            header nav a { padding: 0.3rem 0.6rem; font-size: 0.7rem; }
            header .logo img { height: 4rem; }
            .hero { padding: 5rem 1.5rem; }
            .hero h1 { font-size: 2.5rem; }
            .hero h1 span.or { font-size: 3rem; }
            .hero p { font-size: 0.8rem; }
            h1 { font-size: 2rem; }
            .produits-section .section-titre { font-size: 1.8rem; }
            .produits-grille { grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 1rem; }
            .produit-carte .image-wrapper { height: 220px; }
            .produit-detail {
                grid-template-columns: 1fr;
                gap: 1.5rem;
                padding: 1.5rem;
                margin: 1rem;
            }
            .produit-detail h1 { font-size: 1.5rem; }
            .stats { grid-template-columns: 1fr; }
            .panier-table { font-size: 0.8rem; }
            .panier-table th, .panier-table td { padding: 0.7rem 0.5rem; }
            .form-card { padding: 1.5rem; margin: 1rem; }
            footer .footer-links { flex-wrap: wrap; gap: 1rem; }
        }
    </style>
    {% endblock %}
</head>
<body>
    <header>
        <div class="conteneur">
            <a href="{{ path('app_accueil') }}" class="logo"><img src="{{ asset('favicon.png') }}" alt="CRYSTAL"></a>
            <nav>
                <a href="{{ path('app_accueil') }}">Accueil</a>
                <a href="{{ path('app_boutique') }}">Boutique</a>
                <a href="{{ path('app_about') }}">À propos</a>
                <a href="{{ path('app_contact') }}">Contact</a>
                {% if app.user %}
                    <a href="{{ path('app_profil_commandes') }}">Commandes</a>
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('app_admin') }}">Admin</a>
                    {% endif %}
                    <a href="{{ path('app_logout') }}">Déconnexion</a>
                {% else %}
                    <a href="{{ path('app_login') }}">Connexion</a>
                    <a href="{{ path('app_register') }}">Inscription</a>
                {% endif %}
                <a href="{{ path('app_panier') }}">Panier <span class="badge-panier">{{ nombreArticles ?? 0 }}</span></a>
            </nav>
        </div>
    </header>

    {% block hero %}{% endblock %}

    <main class="conteneur">
        {% for message in app.flashes('success') %}
            <div class="flash-succes">{{ message }}</div>
        {% endfor %}
        {% block body %}{% endblock %}
    </main>

    <footer>
        <div class="footer-links">
            <a href="{{ path('app_accueil') }}">Accueil</a>
            <a href="{{ path('app_boutique') }}">Boutique</a>
            <a href="{{ path('app_about') }}">À propos</a>
            <a href="{{ path('app_contact') }}">Contact</a>
        </div>
        <p>&copy; {{ 'now'|date('Y') }} CRYSTAL — Tous droits réservés</p>
    </footer>
</body>
</html>
