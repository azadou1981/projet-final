<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}CRYSTAL{% endblock %}</title>
    <link rel="icon" type="image/png" href="{{ asset('favicon.png') }}">
    {% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/base.css') }}">
    <link rel="stylesheet" href="{{ asset('css/header.css') }}">
    <link rel="stylesheet" href="{{ asset('css/hero.css') }}">
    <link rel="stylesheet" href="{{ asset('css/buttons.css') }}">
    <link rel="stylesheet" href="{{ asset('css/produits.css') }}">
    <link rel="stylesheet" href="{{ asset('css/tableaux.css') }}">
    <link rel="stylesheet" href="{{ asset('css/stats.css') }}">
    <link rel="stylesheet" href="{{ asset('css/succes.css') }}">
    <link rel="stylesheet" href="{{ asset('css/formulaires.css') }}">
    <link rel="stylesheet" href="{{ asset('css/flash.css') }}">
    <link rel="stylesheet" href="{{ asset('css/footer.css') }}">
    <link rel="stylesheet" href="{{ asset('css/pages.css') }}">
    <link rel="stylesheet" href="{{ asset('css/animations.css') }}">
    <link rel="stylesheet" href="{{ asset('css/responsive.css') }}">
    {% endblock %}
</head>
<body>
    <header>
        <div class="conteneur">
            <a href="{{ path('app_accueil') }}" class="logo"><img src="{{ asset('favicon.png') }}" alt="CRYSTAL"></a>
            <nav>
                <a href="{{ path('app_accueil') }}">Accueil</a>
                <a href="{{ path('app_boutique') }}">Boutique</a>
                <a href="{{ path('app_about') }}">À propos</a>
                <a href="{{ path('app_contact') }}">Contact</a>
                {% if app.user %}
                    <a href="{{ path('app_profil_commandes') }}">Commandes</a>
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('app_admin') }}">Admin</a>
                    {% endif %}
                    <a href="{{ path('app_logout') }}">Déconnexion</a>
                {% else %}
                    <a href="{{ path('app_login') }}">Connexion</a>
                    <a href="{{ path('app_register') }}">Inscription</a>
                {% endif %}
                <a href="{{ path('app_panier') }}">Panier <span class="badge-panier">{{ nombreArticles ?? 0 }}</span></a>
            </nav>
        </div>
    </header>

    {% block hero %}{% endblock %}

    <main class="conteneur">
        {% for message in app.flashes('success') %}
            <div class="flash-succes">{{ message }}</div>
        {% endfor %}
        {% block body %}{% endblock %}
    </main>

    <footer>
        <div class="footer-links">
            <a href="{{ path('app_accueil') }}">Accueil</a>
            <a href="{{ path('app_boutique') }}">Boutique</a>
            <a href="{{ path('app_about') }}">À propos</a>
            <a href="{{ path('app_contact') }}">Contact</a>
        </div>
        <p>&copy; {{ 'now'|date('Y') }} CRYSTAL — Tous droits réservés</p>
    </footer>
</body>
</html>
