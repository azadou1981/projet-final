{% extends 'base.html.twig' %}

{% block title %}Mes commandes - CRYSTAL{% endblock %}

{% block body %}
<h1>Mes <span class="or">commandes</span></h1>

{% if commandes is empty %}
    <div class="empty-state">
        <div class="emoji">📦</div>
        <p>Vous n'avez pas encore de commandes</p>
        <a href="{{ path('app_boutique') }}" class="btn">Commencer →</a>
    </div>
{% else %}
    <div class="table-wrapper">
        <table class="panier-table">
            <thead>
                <tr>
                    <th>N°</th>
                    <th>Date</th>
                    <th>Total</th>
                    <th>Statut</th>
                </tr>
            </thead>
            <tbody>
                {% for commande in commandes %}
                <tr>
                    <td><strong class="numero-commande">#{{ commande.id }}</strong></td>
                    <td>{{ commande.dateCreation|date('d/m/Y') }}</td>
                    <td>{{ commande.total }} €</td>
                    <td>
                        {% if commande.statut == 'en_attente' %}
                            <span class="statut-en-attente">En attente</span>
                        {% elseif commande.statut == 'validée' %}
                            <span class="statut-validee">Validée ✓</span>
                        {% elseif commande.statut == 'expédiée' %}
                            <span class="statut-expediee">Expédiée 🚚</span>
                        {% else %}
                            {{ commande.statut }}
                        {% endif %}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endif %}
{% endblock %}
