{% extends 'base.html.twig' %}

{% block title %}Mes commandes - CRYSTAL{% endblock %}

{% block body %}
<h1>Mes <span class="or">commandes</span></h1>

{% if commandes is empty %}
    <div class="empty-state">
        <div class="emoji">📦</div>
        <p>Vous n'avez pas encore de commandes</p>
        <a href="{{ path('app_boutique') }}" class="btn">Commencer →</a>
    </div>
{% else %}
    <div class="table-wrapper">
        <table class="panier-table">
            <thead>
                <tr>
                    <th>N°</th>
                    <th>Date</th>
                    <th>Total</th>
                    <th>Statut</th>
                </tr>
            </thead>
            <tbody>
                {% for commande in commandes %}
                <tr>
                    <td><strong style="color: var(--or);">#{{ commande.id }}</strong></td>
                    <td>{{ commande.dateCreation|date('d/m/Y') }}</td>
                    <td>{{ commande.total }} €</td>
                    <td>
                        {% if commande.statut == 'en_attente' %}
                            <span style="background: rgba(212,168,67,0.1); color: var(--or); padding: 0.2rem 0.8rem; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; border: 1px solid rgba(212,168,67,0.3);">En attente</span>
                        {% elseif commande.statut == 'validée' %}
                            <span style="background: rgba(255,255,255,0.05); color: var(--blanc-casse); padding: 0.2rem 0.8rem; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; border: 1px solid var(--gris-clair);">Validée ✓</span>
                        {% elseif commande.statut == 'expédiée' %}
                            <span style="background: rgba(212,168,67,0.1); color: var(--or-brillant); padding: 0.2rem 0.8rem; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; border: 1px solid rgba(212,168,67,0.3);">Expédiée 🚚</span>
                        {% else %}
                            {{ commande.statut }}
                        {% endif %}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endif %}
{% endblock %}
