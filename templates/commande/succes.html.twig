{% extends 'base.html.twig' %}

{% block title %}Commande confirmée - CRYSTAL{% endblock %}

{% block body %}
<div class="succes-page">
    <div class="icone">💎</div>
    <h1>Commande <span class="or">confirmée</span> !</h1>
    <p>Commande n°<strong class="couleur-or">#{{ commande.id }}</strong></p>
    <p>Total : <strong class="total-or">{{ commande.total }} €</strong></p>
    <a href="{{ path('app_boutique') }}" class="btn">Continuer mes achats →</a>
</div>
{% endblock %}
