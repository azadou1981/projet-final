{% extends 'base.html.twig' %}

{% block title %}Commande confirmée - Crystal{% endblock %}

{% block body %}
<div class="succes-page">
    <h1>Merci pour votre commande ! 🎉</h1>
    <p>Commande n°<strong>{{ commande.id }}</strong></p>
    <p>Total : <strong>{{ commande.total }} €</strong></p>
    <p>Statut : {{ commande.statut }}</p>
    <a href="{{ path('app_boutique') }}" class="btn">Continuer mes achats</a>
</div>
{% endblock %}
