{% extends 'base.html.twig' %}

{% block title %}Accueil - Crystal{% endblock %}

{% block body %}
<div class="hero">
    <h1>Bienvenue chez Crystal</h1>
    <p>Découvrez notre collection de bijoux et accessoires</p>
    <a href="{{ path('app_boutique') }}" class="btn">Voir la boutique</a>
</div>

<section class="produits-section">
    <h2>Nos derniers produits</h2>
    <div class="produits-grille">
        {% for produit in produits %}
            <article class="produit-carte">
                <img src="{{ produit.image ? asset('uploads/' ~ produit.image) : 'https://placehold.co/300x300' }}" alt="{{ produit.nom }}">
                <h3>{{ produit.nom }}</h3>
                <p class="prix">{{ produit.prix }} €</p>
                <a href="{{ path('app_produit_voir', {'id': produit.id}) }}" class="btn-petit">Voir</a>
            </article>
        {% else %}
            <p>Aucun produit pour le moment.</p>
        {% endfor %}
    </div>
</section>
{% endblock %}
