{% extends 'base.html.twig' %}

{% block title %}Accueil - CRYSTAL{% endblock %}

{% block hero %}
<div class="hero">
    <h1>CRYSTAL<span class="or">STREETWEAR</span></h1>
    <p>Nouvelle collection disponible</p>
    <a href="{{ path('app_boutique') }}" class="btn">Découvrir →</a>
</div>
{% endblock %}

{% block body %}
<section class="produits-section">
    <h2 class="section-titre">Dernières pièces</h2>
    <div class="produits-grille">
        {% for produit in produits %}
            <article class="produit-carte">
                <a href="{{ path('app_produit_voir', {'id': produit.id}) }}">
                    <div class="image-wrapper">
                        <img src="{{ produit.image ? asset('uploads/' ~ produit.image) : 'https://placehold.co/400x400/111111/555?text=' ~ produit.nom }}" alt="{{ produit.nom }}">
                    </div>
                </a>
                <div class="card-body">
                    <h3>{{ produit.nom }}</h3>
                    <div class="prix">{{ produit.prix }} €</div>
                    <div class="card-footer">
                        <a href="{{ path('app_produit_voir', {'id': produit.id}) }}" class="btn-petit">Voir</a>
                        <a href="{{ path('app_panier_ajouter', {'id': produit.id}) }}" class="btn-outline">+</a>
                    </div>
                </div>
            </article>
        {% else %}
            <div class="empty-state">
                <div class="emoji">💎</div>
                <p>Aucun produit pour le moment.</p>
            </div>
        {% endfor %}
    </div>
</section>
{% endblock %}
