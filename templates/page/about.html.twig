{% extends 'base.html.twig' %}
 
{% block title %}À propos - Crystal{% endblock %}
 
{% block body %}
<div class="hero">
    <h1>À propos de Crystal</h1>
    <p>Notre histoire, notre passion</p>
</div>
 
<section class="produits-section">
    <div class="conteneur">
        <h2>Notre histoire</h2>
        <p class="about-intro">
            Crystal est une boutique de bijoux et accessoires de mode fondée en 2020. 
            Nous sélectionnons avec soin chaque pièce pour vous offrir des produits 
            élégants, intemporels et accessibles.
        </p>
 
        <div class="stats stats-large">
            <div class="stat-carte">
                <h3>500+</h3>
                <p>Clients satisfaits</p>
            </div>
            <div class="stat-carte">
                <h3>50+</h3>
                <p>Produits uniques</p>
            </div>
            <div class="stat-carte">
                <h3>5</h3>
                <p>Années d'expérience</p>
            </div>
        </div>
    </div>
</section>
{% endblock %}